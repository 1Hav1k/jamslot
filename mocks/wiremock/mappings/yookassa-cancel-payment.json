{
  "name": "ЮKassa: отменить платёж",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/v3/payments/[^/]+/cancel",
    "basicAuthCredentials": { "username": "123456", "password": "test_secret" },
    "headers": { "Idempotence-Key": { "matches": ".+" } }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "status": "canceled",
      "paid": false,
      "cancellation_details": { "party": "merchant", "reason": "canceled_by_merchant" }
    }
  }
}
